i# ============================================
# PesaLoan - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env files to version control!

# ============================================
# Application
# ============================================
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=debug

# ============================================
# Database
# ============================================
# Local: postgresql://postgres:postgres@localhost:5432/pesaloan
# Docker: postgresql://postgres:postgres@postgres:5432/pesaloan
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pesaloan?schema=public

# ============================================
# Redis
# ============================================
# Local: redis://localhost:6379
# Docker: redis://redis:6379
REDIS_URL=redis://localhost:6379

# ============================================
# JWT Authentication
# ============================================
# Generate with: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-change-in-production
JWT_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=90d

# ============================================
# Encryption (for sensitive data at rest)
# ============================================
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=your-32-char-encryption-key-change-in-production

# ============================================
# M-Pesa (Safaricom Daraja API)
# ============================================
# Get from: https://developer.safaricom.co.ke/
# Sandbox: https://sandbox.safaricom.co.ke
# Production: https://api.safaricom.co.ke
MPESA_CONSUMER_KEY=your-consumer-key
MPESA_CONSUMER_SECRET=your-consumer-secret
MPESA_PASSKEY=your-passkey
MPESA_SHORTCODE=your-shortcode
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_CALLBACK_URL=http://localhost:3000/api/v1/mobile-money/mpesa/callback

# ============================================
# Airtel Money
# ============================================
# Get from: https://openapi.airtel.africa/
AIRTEL_CLIENT_ID=your-client-id
AIRTEL_CLIENT_SECRET=your-client-secret
AIRTEL_BASE_URL=https://openapi-sandbox.airtel.africa
AIRTEL_CALLBACK_URL=http://localhost:3000/api/v1/mobile-money/airtel/callback

# ============================================
# KYC Provider
# ============================================
# Options: mock, smile_identity, prembly, custom
KYC_PROVIDER=mock
KYC_API_KEY=your-kyc-api-key
KYC_BASE_URL=https://api.kyc-provider.com

# ============================================
# SMS Provider
# ============================================
# Options: mock, africas_talking, twilio, custom
SMS_PROVIDER=mock
SMS_API_KEY=your-sms-api-key
SMS_SENDER_ID=PesaLoan

# ============================================
# Push Notifications
# ============================================
# Options: mock, firebase, onesignal, custom
PUSH_PROVIDER=mock
PUSH_API_KEY=your-push-api-key
PUSH_PROJECT_ID=your-firebase-project-id

# ============================================
# Email (for admin notifications)
# ============================================
SMTP_HOST=smtp.mailhog.local
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@PesaLoan.co.ke

# ============================================
# CORS
# ============================================
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3000,capacitor://localhost

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60000

# ============================================
# Feature Flags
# ============================================
ENABLE_BIOMETRIC=true
ENABLE_REFERRALS=false
ENABLE_LOYALTY=false
