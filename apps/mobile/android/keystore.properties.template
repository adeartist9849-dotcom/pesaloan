# Android Signing Configuration
# Copy this file to keystore.properties and fill in your values
# NEVER commit the actual keystore.properties file to version control!

# Keystore file path (relative to android/app or absolute)
storeFile=../pesaloan-release.keystore

# Keystore password
storePassword=YOUR_KEYSTORE_PASSWORD

# Key alias
keyAlias=pesaloan-release-key

# Key password
keyPassword=YOUR_KEY_PASSWORD